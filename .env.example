# Gemini provider
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# Firebase Web App configuration (safe to expose to the browser, but still keep in Render config)
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=

# App session security
SESSION_SECRET=

# Auth0 Regular Web Application; set all four values to activate Auth0 Universal Login
AUTH0_ISSUER_BASE_URL=https://YOUR_TENANT.auth0.com
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_SECRET=
AUTH0_BASE_URL=https://agent-garden-chat.onrender.com
DATA_ENCRYPTION_KEY=
D1_WORKER_URL=
D1_WORKER_KEY=
PUBLIC_ORIGIN=http://localhost:3000
E2B_ALLOW_INTERNET=true
NODE_ENV=development
PORT=3000

# Tigris S3-compatible object storage
STORAGE_PROVIDER=tigris
TIGRIS_BUCKET_NAME=
TIGRIS_ENDPOINT=https://t3.storage.dev
TIGRIS_REGION=auto
TIGRIS_ACCESS_KEY_ID=
TIGRIS_SECRET_ACCESS_KEY=
