# Gemini provider
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# Firebase Web App configuration (safe to expose to the browser, but still keep in Render config)
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=

# App session security
SESSION_SECRET=
NODE_ENV=development
PORT=3000

# Tigris S3-compatible object storage
STORAGE_PROVIDER=tigris
TIGRIS_BUCKET_NAME=
TIGRIS_ENDPOINT=https://t3.storage.dev
TIGRIS_REGION=auto
TIGRIS_ACCESS_KEY_ID=
TIGRIS_SECRET_ACCESS_KEY=
