# Required: Gemini API key from Google AI Studio. Keep private.
GEMINI_API_KEY=

# Optional: choose another Gemini model available to your API key.
GEMINI_MODEL=gemini-3.1-flash-lite

# Required: Google Cloud OAuth 2.0 Web client ID for Sign in with Google.
GOOGLE_CLIENT_ID=

# Required: generate a long random secret for signed application sessions.
SESSION_SECRET=

# Runtime settings
NODE_ENV=development
PORT=3000
