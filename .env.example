# Gemini provider
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# Firebase Web App configuration (safe to expose to the browser, but still keep in Render config)
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=

# Firebase Admin SDK credentials (server-only secrets)
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
# Paste the private key with literal \n characters preserved, or replace line breaks with \\nFIREBASE_ADMIN_PRIVATE_KEY=

# App session security
SESSION_SECRET=
NODE_ENV=development
PORT=3000
